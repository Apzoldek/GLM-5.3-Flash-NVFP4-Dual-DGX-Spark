FROM glm53-flash-sm121:v8

# Mia's Spark serving layer — MM + Ray TP2 + OpenAI API on :8888.
# Kernel work is the sibling Dockerfile (sm90 on GB10).
# Both Dockerfiles use context files/ so COPY paths stay next to build.sh.
# start.sh on this kit expects Ray already in the image (inner pip is a no-op).

LABEL org.opencontainers.image.vendor="Mia" \
      org.opencontainers.image.title="Mia Spark GLM-5.3-Flash-NVFP4 (MM + Ray)" \
      org.opencontainers.image.description="Mia's Spark MM+Ray recipe on GB10: LibertAIDAI/GLM-5.3-Flash-NVFP4 checkpoint, multimodal, Ray TP2, OpenAI API :8888" \
      org.opencontainers.image.source="https://huggingface.co/LibertAIDAI/GLM-5.3-Flash-NVFP4" \
      org.opencontainers.image.base.name="vllm/vllm-openai:glm53-flash-arm64-cu130" \
      io.mia.spark.runtime="mm-ray-v1"

ENV TORCH_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_DISABLE_VERSION_CHECK=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    VLLM_ENGINE_READY_TIMEOUT_S=3600 \
    PORT=8888 \
    RAY_VERSION=2.58.0 \
    GLM53_LIMIT_MM='{"image":4,"video":1}' \
    GLM53_SKIP_MM_PROFILING=1

# Ray is how this kit does TP2 across spark1/spark2.
RUN pip install --no-cache-dir "ray[default]==2.58.0" \
    && python3 -c "import ray; print('[mia-sm121] ray', ray.__version__)"

# Baked jinja fallback for a plain docker run. start.sh still refreshes the
# HF snapshot (emit_image / emit_video) and passes --chat-template.
COPY chat_template.jinja /opt/glm53/chat_template.jinja
